# ── Frontend (Vite) ──────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_APP_URL=https://menuvia.netlify.app
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Număr WhatsApp pentru CTA "Discută cu fondatorul" pe landing + enterprise.
# Format internațional fără + (ex: 40751234567 pentru România). Lipsa →
# butoanele ascunse (fail-safe pentru deploy-uri preview/staging).
VITE_WHATSAPP_NUMBER=

# ── Netlify Functions ────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
RESEND_API_KEY=re_...
ANTHROPIC_API_KEY=sk-ant-...

# Webhook secret for Supabase DB webhooks (welcome-email)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-random-secret-here

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID per plan canonic. Creează produsele în Stripe Dashboard și pune
# price IDs aici. Lipsa unui price ID = planul respectiv dă 400 la checkout
# (defensiv — nu mai cade silent pe pro).
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
# Trial în zile pentru orice plan nou (default 30 dacă nesetat; 0 = fără trial)
STRIPE_TRIAL_DAYS=30

# Web Push Notifications (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=           # Public VAPID key (safe to expose)
VAPID_PUBLIC_KEY=                # Same as above (used by send-push.js)
VAPID_PRIVATE_KEY=               # Private VAPID key (NEVER expose in frontend!)
VAPID_EMAIL=noreply@menuvia.ro   # Contact email for VAPID

# ── PostHog Analytics ────────────────────────────────────────
# Folosit în src/lib/analytics.ts. Fallback grațios (warn) dacă lipsește.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Sentry Source Maps (BUILD-time only) ─────────────────────
# NU pune în .env local — adaugă în Netlify Environment Variables.
# Auth token: https://sentry.io/settings/account/api/auth-tokens/
# Scope necesar: project:releases + project:read
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ── Slack Webhook pentru Health Score critic ─────────────────
# Folosit de send-health-slack-alerts (cron Netlify la :05/:20/:35/:50).
# Notifică admin (Radu) când scor < 40 + trend critical pe un restaurant.
# Lasă gol = feature OFF, cron exit silent fără să atingă DB.
# Format: https://hooks.slack.com/services/T.../B.../...
# SLACK_WEBHOOK_URL=

# ── Alarma de stocare din /health (mig 266) ──────────────────
# Când Postgres atinge plafonul planului, baza trece în READ-ONLY: platforma nu
# mai acceptă comenzi, la NICIUN restaurant. /health raportează 80% (200, doar
# vizibil) și 90% (503, alertează).
#
# Plafonul planului, în OCTEȚI, FĂRĂ sufix de unitate ("8GB" e invalid și e
# ignorat CU avertisment în log). Lasă gol = 500 MB (planul Free).
# DB_SIZE_LIMIT_BYTES=
#
# Deblochează `storage_detail` (octeți, plafon, procent, primele 5 tabele) prin
# antetul `x-health-diag: <token>`. NU se acceptă în query string: un secret în
# URL ajunge în logurile de request, in configul monitorului si in istoricul de
# shell (CWE-598).
# LASĂ GOL = diagnosticul NU e accesibil de nicăieri (fail-closed) — /health e
# public, deci fără token expune doar severitatea, nu cifre. Setează-l ÎNAINTE
# de un incident: altfel afli că baza e la 92% și nu poți vedea de unde să tai
# fără să editezi env și să redeployezi în plin incident.
# HEALTH_DIAG_TOKEN=
